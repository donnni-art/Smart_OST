{
  "ShowLogs": true,
  "LiveCompileQss": true,
  "CheckForMissingicons": true,
  "QtBinding": "PySide6",
  "QMainWindow": [
    {
      "tittle": "SMART OST ",
      "icon": ":/font_awesome_brands/icons/font_awesome/brands/foursquare.png",
      "frameless": true,
      "translucentBg": true,
      "sizeGrip": "sizeGrip",
      "navigation":[
        {
          "minimize":"minimizeBtn",
          "close": "closeBtn",
          "moveWindow": "header",
          "tittleBar": "header",
          "restore":[
            { 
              "buttonName": "restoreBtn",
              "normalIcon": ":/feather/icons/feather/square.png",
              "maximizedIcon":":/feather/icons/feather/copy.png"
            }
          ]
        }
      ]
    }
  ],
  "QSettings": [
    {
      "ThemeSettings": [
        {
          "CustomTheme": [
            {
              "Background-color": "#FFFFFF",
              "Text-color": "#010000",
              "Icons-color": "#000000",
              "Accent-color": "#26bae3",
              "Theme-name": "Ligh-tBlue",
              "Default-Theme": true
            },
            {
              "Background-color": "#21272a",
              "Text-color": "#fefefe",
              "Icons-color": "#fefefe",
              "Accent-color": "#fba43b",
              "Theme-name": "Dark-Yellow",
              "Default-Theme": false
            }
          ]
        }
      ],
      "AppSettings": {
        "OrginizationName": "SMART OST ",
        "ApplicationName": "SMART OST  Company",
        "OrginizationDormain": "SMART OST .org"
      }
    }
  ],
  "QPushButtonGroup": [
    {
    "Buttons": [
        "dashboardBtn",
        "dataBtn",
        "operatorBtn",
        "moreBtn"
    ],
    "ActiveButton": "dashboardBtn",
    "Style":[
        {
            "Active": "QPushButton{background-color: THEME.COLOR_BACKGROUND_2; font-weight: bold; border-top: 2px solid $COLOR_BACKGROUND_3; border-left: 5px solid $COLOR_BACKGROUND_3;border-bottom: 6px solid $COLOR_BACKGROUND_3;}",
            "NotActive": "QPushButton{background-color: transparent; font-weight: normal; border-top: 2px solid transparent; border-left: 5px solid transparent;border-bottom: 6px solid transparent;}"
        }
    ]
    },
    {
    "Buttons": [
          "repairBtn",
          "informationBtn",
          "settingsBtn",
          "closeCenterMenuBtn"
    ],
    "ActiveButton": "closeCenterMenuBtn",
    "Style":[
      {
        "Active": "QPushButton{background-color: THEME.COLOR_ACCENT_1; font-weight: bold; border-top: 6px solid $COLOR_BACKGROUND_3; border-left: 6px solid $COLOR_BACKGROUND_3;border-bottom: 6px solid $COLOR_BACKGROUND_3;}",
        "NotActive": "QPushButton{background-color: transparent; font-weight: normal; border-top: 6px solid transparent; border-left: 6px solid transparent;border-bottom: 6px solid transparent;}"
      }
    ]
    }
  ],
  "QCustomSlideMenu": [
    {
    "name": "leftMenu",
    "defaultSize": [
      {
      "width": 41,
      "height": "parent"
      }
    ],
    "collapsedSize": [
      {
        "width": 41,
        "height":"parent"
      }
    ],
    "expandedSize": [
      {
        "width": 130,
        "height": "parent"
      }
    ],
    "menuTransitionAnimation": [
      {
      "animationDuration": 200,
      "animationEasingCurve": "Linear"
      }
    ],
    "toggleButton": [
      {
      "buttonName": "menuBtn",
      "icons": [
        {
        "whenMenuIsCollapsed": ":/feather/icons/feather/align-justify.png",
        "whenMenuIsExpanded": ":/feather/icons/feather/arrow-left-circle.png"
        }
      ]
      }
    ]
    },
    {
      "name": "centerMenu",
      "defaultSize": [
        {
          "width": 0,
          "height": "parent"
        }
      ],
      "collapsedSize": [
        {
          "width": 0,
          "height": "parent"
        }
      ],
      "expandedSize": [
        {
          "width": 200,
          "height": "parent"
        }
      ],
      "menuTransitionAnimation": [
        {
        "animationDuration": 200,
        "animationEasingCurve": "Linear"
        }
      ]
    }
  ],
  "QCustomQStackedWidget": [
    {
    "name": "mainPages",
    "navigation": [
      {
      "navigationButtons": [
        {
        "dashboardBtn": "dashboardPage",
        "dataBtn": "dataPage",
        "operatorBtn": "operator_2",
        "moreBtn": "morePage"
        }
      ]
      }
    ],
    "transitionAnimation": [
      {
      "fade": [
        {
        "active": true,
        "duration": 500,
        "easingCurve": "InSine"
        }
      ]
      }
    ]
    },
    {
    "name": "stackedWidget",
    "navigation": [
      {
      "navigationButtons": [
        {
        "repairBtn": "Repair",
        "informationBtn": "information",
        "settingsBtn": "settingsPage"
        }
      ]
      }
    ],
    "transitionAnimation": [
      {
      "slide": [
        {
        "active": true,
        "duration": 200,
        "easingCurve": "InSine"
        }
      ]
      }
    ]
    }
  ]
}